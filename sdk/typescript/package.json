{
  "name": "@splashprotocol/green-order-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for building, signing, submitting, and monitoring Splash green orders.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist",
    "README.md"
